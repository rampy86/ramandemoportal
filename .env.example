# ─────────────────────────────────────────────────────────────────────────────
# Meridian Capital Portal — Environment Variables
# Copy to .env for local runs. On a host (Render etc.) set these in its dashboard.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key

# Frontend origins allowed to call the API. Comma list, JSON list, or *
# Not needed when the API serves the HTML itself (same origin).
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

# Serve frontend/index.html at "/"
SERVE_FRONTEND=true

# ── Demo / prototype ───────────────────────────────────────────────────────
SEED_DEMO_DATA=true                 # create demo investors + sample documents on startup
DEMO_PASSWORD=ChangeMe123!
DEMO_EXTRA_EMAIL=                   # e.g. your own address, to receive real OTP emails
DEMO_EXTRA_NAME=Demo Investor
DEMO_SHOW_OTP=true                  # PROTOTYPE ONLY: returns the code to the UI. Set false once emails arrive.
ALLOW_OTP_SIGNUP=true               # "Email code" sign-in creates an account for any new email

# ── Email delivery ─────────────────────────────────────────────────────────
# auto | brevo | smtp | console
EMAIL_PROVIDER=auto

# Option 1: Brevo HTTPS API (works on free hosts that block SMTP, e.g. Render free)
BREVO_API_KEY=

# Option 2: Gmail SMTP (fine locally / on paid hosts)
#   1. Enable 2-Step Verification on your Google account
#   2. https://myaccount.google.com/apppasswords → create an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

EMAIL_FROM_NAME=Meridian Capital Investor Relations
EMAIL_FROM_ADDRESS=                 # Brevo: a verified sender. SMTP: defaults to SMTP_USER

# ── Database ───────────────────────────────────────────────────────────────
# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./meridian.db
# Any Postgres URL works as copied from the provider (Neon, Supabase, RDS), e.g.
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ── AWS S3 (document storage) — leave blank to store files in ./uploads ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ── MFA settings ──────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
MAX_OTP_ATTEMPTS=5
